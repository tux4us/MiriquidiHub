<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gedrückter Zustand (Top-Fläche senkt sich ab) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#051204" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#183616"
                        android:endColor="#0D210B"
                        android:angle="270" />
                    <stroke
                        android:width="1dp"
                        android:color="#30FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normaler Zustand (3D-Kante unten sichtbar) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#040F04" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#234A21"
                        android:centerColor="#173B15"
                        android:endColor="#0E280C"
                        android:angle="270" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#5081C784" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
