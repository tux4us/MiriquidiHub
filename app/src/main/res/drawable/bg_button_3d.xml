<?xml version="1.0" encoding="utf-8"?>
<!-- Glas-Kachel mit grünem Akzent (Name bleibt für bestehende Layout-Referenzen erhalten) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D81C784"
                android:endColor="#2E4CAF50" />
            <stroke android:width="1dp" android:color="@color/glass_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#1F69C46A"
                android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_strong" />
        </shape>
    </item>
</selector>
