<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gedrückter Zustand (Top-Fläche senkt sich ab) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#082806" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#1B5E20"
                        android:endColor="#0F460D"
                        android:angle="270" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normaler Zustand (3D-Kante unten sichtbar) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#062005" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#2E7D32"
                        android:centerColor="#1E6B22"
                        android:endColor="#0F460D"
                        android:angle="270" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#60FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
