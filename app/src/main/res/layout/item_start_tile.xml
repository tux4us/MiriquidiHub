<?xml version="1.0" encoding="utf-8"?>
<!-- Kachel der Startseite. Breite/Höhe und Gitterposition setzt StartActivity (Grid) bzw. das include (Spende).
     Höhe wächst mit der Schrift (wrap_content, kein Abschneiden); Zeilen des Grids werden auf gleiche Höhe gestreckt. -->
<io.github.tux4us.miriquidihub.GlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.Tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:minHeight="72dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_badge_glass"
            android:padding="9dp">

            <ImageView
                android:id="@+id/tileIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                app:tint="@color/rd_text_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:textAppearance="@style/TextAppearance.App.TileTitle"
            android:hyphenationFrequency="normal"
            android:breakStrategy="balanced" />
    </LinearLayout>
</io.github.tux4us.miriquidihub.GlassCardView>
