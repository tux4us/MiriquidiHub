<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MiriquidiHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Hell-Theme (Light) -->
        <item name="colorPrimary">#0F460D</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#B8F2AE</item>
        <item name="colorOnPrimaryContainer">#022100</item>
        <item name="colorSecondary">#53634F</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#F7FBF1</item>
        <item name="colorOnSurface">#191D17</item>
        <item name="colorOutline">#72796F</item>

        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

        <!-- Toolbar Icon Fix -->
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AppCompat.Light</item>
    </style>

    <style name="Theme.MiriquidiHub.Translucent" parent="Theme.MiriquidiHub">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>